<Project>

  <!-- Shared build settings for every project in this repository.
       MSBuild imports this file into each .csproj before the project's own body,
       so a property set in a .csproj overrides the value here. -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
